# Current stage
RTMP_BIND=0.0.0.0
HTTP_BIND=127.0.0.1
RECORD_RETENTION_DAYS=14

# Basic Auth for /control and /stat.
# Leave CONTROL_PASSWORD empty to disable /control and keep /stat inside the container.
CONTROL_USER=admin
CONTROL_PASSWORD=
# Optional: read the password from a file or Docker secret instead of the environment.
# CONTROL_PASSWORD_FILE=/run/secrets/control_password

# Future nginx-proxy stage; not used by this compose file
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_TEST=true

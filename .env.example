# Current stage
RTMP_BIND=0.0.0.0
HTTP_BIND=127.0.0.1
RECORD_RETENTION_DAYS=14

# Basic Auth for the player page, /control, and /stat.
# Leave CONTROL_PASSWORD empty to leave the player public and keep /stat inside the container.
CONTROL_USER=admin
CONTROL_PASSWORD=
# Optional: read the password from a file or Docker secret instead of the environment.
# CONTROL_PASSWORD_FILE=/run/secrets/control_password

# Public hostname is ${HOST_PREFIX}01.${DOMAIN} through ${HOST_PREFIX}09.${DOMAIN}.
# The defaults below produce stream01.example.com through stream09.example.com.
# Override both in the local .env for another environment. Do not commit that file.
DOMAIN=example.com
HOST_PREFIX=stream
# How many streams to run, from 1 to 9. haproxy/render.sh --container N overrides this once.
STREAM_COUNT=9
# Optional Let's Encrypt contact address. Leave this empty to keep the account
# contact unset. render.sh does not request a certificate.
CERTBOT_EMAIL=
# HAProxy forwards Let's Encrypt HTTP-01 challenges to this port.
ACME_PORT=9080
# Public TLS port for the stream hostnames. 443 is the normal HTTPS port.
# Set another port, such as 4447, when 443 already serves other sites.
HTTPS_PORT=443

# Host RTMP ports. The container-side port stays 1935.
RTMP_PORT_1=1935
RTMP_PORT_2=1936
RTMP_PORT_3=1937
RTMP_PORT_4=1938
RTMP_PORT_5=1939
RTMP_PORT_6=1940
RTMP_PORT_7=1941
RTMP_PORT_8=1942
RTMP_PORT_9=1943

# Host HTTP ports for HAProxy. The container-side port stays 80.
HTTP_PORT_1=18080
HTTP_PORT_2=18081
HTTP_PORT_3=18082
HTTP_PORT_4=18083
HTTP_PORT_5=18084
HTTP_PORT_6=18085
HTTP_PORT_7=18086
HTTP_PORT_8=18087
HTTP_PORT_9=18088
